# Blink UGC API — copy to server/.env and fill in.
# Every value here is a secret except PORT and the origins. None of them are
# ever sent to the browser.

NODE_ENV=development
PORT=8080

# Where the browser app runs. Drives CORS, and is the origin this server pulls
# creator reference stills from when conditioning a Blink AI generation.
WEB_ORIGIN=http://localhost:5199
# Optional extra origins (preview deploys, custom domains), comma-separated.
EXTRA_ORIGINS=

# ─── Supabase ───────────────────────────────────────────────────────────────
# Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
# Bypasses row level security. Server only — never expose this.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Razorpay ───────────────────────────────────────────────────────────────
# Dashboard → Account & Settings → API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Settings → Webhooks → the secret you set when creating the hook
RAZORPAY_WEBHOOK_SECRET=

# ─── fal ────────────────────────────────────────────────────────────────────
# Every generation in the product: Blink AI video, animated-carousel images and
# the slide copy. https://fal.ai/dashboard/keys
#
# Video was Google Veo on a separate balance until that balance ran dry and took
# Blink AI down for every paying subscriber. One vendor, one balance to watch.
FAL_KEY=
# Optional overrides; the defaults are in server/src/env.js.
# FAL_VIDEO_MODEL=fal-ai/wan/v2.2-a14b/text-to-video
# FAL_VIDEO_IMAGE_MODEL=fal-ai/wan/v2.2-a14b/image-to-video
# FAL_IMAGE_MODEL=fal-ai/nano-banana

# How many animated carousels one account may generate per calendar month.
# Each is roughly $0.20 of image generation against a $7.99 plan.
ANIMATED_MONTHLY_LIMIT=30
