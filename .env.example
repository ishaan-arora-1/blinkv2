# Blink AI — Google Veo video generation.
# Copy to .env and fill in your own key, then restart the dev server.
#
# NOTE: Vite inlines every VITE_* var into the client bundle, so this key is
# visible to anyone who loads a built copy of the app. Fine for local use;
# put it behind a server-side proxy before shipping this publicly.
VITE_GOOGLE_AI_KEY=
VITE_GOOGLE_AI_MODEL=veo-3.1-generate-preview
