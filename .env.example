# Blink UGC web app — copy to .env and fill in.
#
# Vite inlines every VITE_* variable into the client bundle, so ONLY put values
# here that are safe to be public. The Google AI key used to live in this file;
# it now lives in server/.env, where the browser cannot read it.

# ─── Supabase ───────────────────────────────────────────────────────────────
# Project Settings → API. The anon key is designed to be public — row level
# security is what protects the data.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=

# ─── API ────────────────────────────────────────────────────────────────────
# The Railway deployment of server/. Locally this is http://localhost:8080.
VITE_API_URL=http://localhost:8080

# ─── Analytics (PostHog) ────────────────────────────────────────────────────
# PostHog → Project Settings → Project API Key. Like the Supabase anon key this
# one is public: it can write events and read nothing.
#
# Leave BOTH blank locally. The analytics module no-ops without a key, which is
# what keeps development traffic out of the production numbers.
VITE_POSTHOG_KEY=
# EU projects use https://eu.i.posthog.com. Defaults to the US host.
VITE_POSTHOG_HOST=https://us.i.posthog.com
